{
  "name": "@cookmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file=../../.env src/evals/run.ts",
    "measure:limits": "tsx --env-file=../../.env scripts/measure-limits.ts",
    "mcp": "tsx --env-file=../../.env src/mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@cookmate/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
