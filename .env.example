# ---- Anthropic ----
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which model generates recipes. See apps/api/src/llm/models.ts for the tier table.
# claude-sonnet-5 -> the default. 36/36 on the eval suite WITH the repair loop,
#                   at $0.0463 per passing recipe. Only 26/36 without it.
# claude-opus-5   -> 36/36 first-pass, no repair needed, $0.0561 per pass.
#                   Buys a better tail latency (38.6s max vs 46.1s), not a
#                   better pass rate. Run `pnpm eval` before you switch either way.
RECIPE_MODEL=claude-sonnet-5

# Effort is a SEPARATE cost lever from model choice: low | medium | high | xhigh | max
RECIPE_EFFORT=medium

# ---- Admission control ----
# Two mechanisms, defending different things. A rate limit bounds BURST but not
# money (cost per turn varies — the repair loop roughly doubles it). A cost cap
# bounds SPEND but not burst (concurrent requests all read the same under-cap
# total before any is billed). You need both.
#
# To PROVE these work, lower the limit to meet the load you already have rather
# than raising load to meet the limit — see scripts/measure-limits.ts.
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_PER_USER=2
DAILY_COST_CAP_USD=2
GLOBAL_DAILY_COST_CAP_USD=20
# Claimed against the cap while a call is in flight and its cost is unknown.
ESTIMATED_TURN_COST_USD=0.06

# ---- Supabase (Google OAuth only; app data lives in SQLite) ----
# Project settings -> API. Leave commented out to run without auth.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ---- Server ----
PORT=8787
DATABASE_PATH=./data/cookmate.db
LOG_LEVEL=info

# Set to 1 to bypass auth for local development (never in production)
DEV_ALLOW_ANONYMOUS=1
